{
  "uid": "bcb",
  "title": "BCB",
  "description": "Envio de mensagens, fila, API e JVM do backend",
  "tags": [
    "bcb"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "priority",
        "label": "Prioridade",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(bcb_messages_sent_total, priority)",
          "refId": "priority"
        },
        "definition": "label_values(bcb_messages_sent_total, priority)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
