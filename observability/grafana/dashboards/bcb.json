        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(bcb_messages_sent_total{priority=~\"$priority\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false
