      "title": "Aplicação",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Exporter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_up, job)",
          "refId": "job"
        },
        "definition": "label_values(pg_up, job)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "datname",
        "label": "Banco",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_stat_database_numbackends{job=\"$job\", datname!~\"template.*|postgres\"}, datname)",
          "refId": "datname"
        },
        "definition": "label_values(pg_stat_database_numbackends{job=\"$job\", datname!~\"template.*|postgres\"}, datname)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
