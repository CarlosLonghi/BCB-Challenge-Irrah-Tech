# Copie para .env (o docker compose lê sozinho). Sem .env valem os padrões de dev do docker-compose.yaml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
RABBITMQ_USER=bcb
RABBITMQ_PASSWORD=troque-esta-senha
# Mínimo de 32 bytes. Ex.: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-bytes
# Login do Grafana (perfil observability, http://localhost:3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# Endereço do Grafana nos links das notificações (padrão: http://localhost:3001)
GRAFANA_ROOT_URL=http://localhost:3001
# Webhook do canal do Discord que recebe os alertas. Só é lido com o docker-compose.discord.yaml. É segredo: não versione
GRAFANA_DISCORD_WEBHOOK_URL=
